subdirs = [
    "*"
]

soong_config_module_type {
    name: "agm_hidl_package_root",
    module_type: "hidl_package_root",
    config_namespace: "agm",
    variables: ["hal_variant"],
    properties: ["path"],
}

soong_config_string_variable {
    name: "hal_variant",
    values: [
        "without_set_params",
        "with_get_params",
    ],
}

agm_hidl_package_root {
    name: "vendor.qti.hardware.AGMIPC",
    soong_config_variables: {
        hal_variant: {
            conditions_default: {
                path: "hardware/qcom-caf/sm8450/audio/agm/ipc/HwBinders/interfaces/AGMIPC",
            },
            without_set_params: {
                path: "hardware/qcom-caf/sm8450/audio/agm/ipc/HwBinders/interfaces/AGMIPC_without_set_params",
            },
            with_get_params: {
                path: "hardware/qcom-caf/sm8450/audio/agm/ipc/HwBinders/interfaces/AGMIPC_with_get_params",
            },
        },
    },
}
