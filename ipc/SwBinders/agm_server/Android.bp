cc_library_shared {
    name: "libagmproxy",

    cflags: ["-Wall"],
    srcs: ["src/ipc_proxy_server.cpp"],

    export_include_dirs: ["."],

    shared_libs: [
        "libbinder",
        "libcutils",
        "libdl",
        "liblog",
        "libutils",
    ],

}

cc_binary {
    name: "agmserver",

    defaults: [
        "qtiaudio_dynamic_log_defaults",
    ],

    srcs: [
        "src/agm_server_daemon.cpp",
        "src/agm_server_wrapper.cpp",
    ],

    shared_libs: [
        "libagmproxy",
        "libbinder",
        "libcutils",
        "libdl",
        "liblog",
        "libutils",
    ],
}
