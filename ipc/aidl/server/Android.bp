cc_library_shared {
    name: "libagmipcservice",
    defaults: [
        "android_hardware_qtiaudio_config_defaults",
    ],
    owner: "qti",
    vendor: true,

    tidy: true,

    cflags: [
        "-v",
        "-Wall",
        "-Wthread-safety",
    ],

    srcs: [
        "AgmServerWrapper.cpp",
        "Service.cpp",
    ],

    shared_libs: [
        "libagm",
        "libar-gsl",
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "vendor.qti.hardware.agm-V1-ndk",
    ],

    static_libs: [
        "libagmaidltypeconverter",
        "libaidlcommonsupport",
    ],
}
