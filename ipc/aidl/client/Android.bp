cc_library_shared {
    name: "libagmclient",
    owner: "qti",
    vendor: true,

    tidy: true,

    cflags: [
        "-v",
        "-Wall",
        "-Wthread-safety",
    ],

    srcs: [
        "AgmCallback.cpp",
        "AgmClientWrapper.cpp",
    ],

    header_libs: ["libagm_headers"],

    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "vendor.qti.hardware.agm-V1-ndk",
    ],

    static_libs: [
        "libagmaidltypeconverter",
        "libaidlcommonsupport",
    ],
}
