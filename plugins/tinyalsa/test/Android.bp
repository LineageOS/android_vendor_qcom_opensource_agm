cc_binary {
    name: "agmcompressplay",
    owner: "qti",

    vendor: true,

    cflags: [
        "-DBACKEND_CONF_FILE=\"/vendor/etc/backend_conf.xml\"",
        "-Wno-unused-parameter",
        "-Wno-unused-result",
        "-Wno-unused-variable",
    ],

    include_dirs: [
        "external/tinycompress/include",
    ],
    srcs: ["agmcompressplay.c"],

    header_libs: [
        "libagm_headers",
        "libarpal_headers",
    ],

    shared_libs: [
        "libagmmixer",
        "libtinyalsa",
        "libtinycompress",
    ],
}

cc_binary {
    name: "agmcompresscap",
    owner: "qti",

    vendor: true,

    cflags: [
        "-DBACKEND_CONF_FILE=\"/vendor/etc/backend_conf.xml\"",
        "-Wno-unused-parameter",
        "-Wno-unused-result",
    ],

    include_dirs: [
        "external/tinycompress/include",
    ],
    srcs: ["agmcompresscap.c"],

    header_libs: [
        "libagm_headers",
        "libarpal_headers",
    ],

    shared_libs: [
        "libagmmixer",
        "libtinyalsa",
        "libtinycompress",
    ],
}

cc_binary {
    name: "agmvoiceui",
    owner: "qti",

    vendor: true,

    cflags: [
        "-DBACKEND_CONF_FILE=\"/vendor/etc/backend_conf.xml\"",
        "-Wno-incompatible-function-pointer-types",
        "-Wno-pointer-sign",
        "-Wno-unused-parameter",
        "-Wno-unused-result",
        "-Wno-unused-variable",
        "-Wno-varargs",
    ],
    srcs: ["agm_voiceui.c"],

    header_libs: [
        "libagm_headers",
        "libarpal_headers",
    ],

    shared_libs: [
        "libagmmixer",
        "libtinyalsa",
    ],
}
