cc_library_shared {
    name: "libagmmixer",
    owner: "qti",

    vendor: true,

    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-result",
        "-Wno-unused-variable",
    ],
    srcs: ["agmmixer.c"],

    header_libs: [
        "libagm_headers",
        "libarpal_headers",
    ],

    shared_libs: [
        "libexpat",
        "libtinyalsa",
    ],
}

cc_binary {
    name: "agmplay",
    owner: "qti",

    vendor: true,

    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-result",

        "-DBACKEND_CONF_FILE=\"/vendor/etc/backend_conf.xml\"",
        "-Wno-format-insufficient-args",
        "-Wno-unused-variable",
    ],
    srcs: ["agmplay.c"],

    header_libs: [
        "libagm_headers",
        "libarpal_headers",
    ],

    shared_libs: [
        "libagmmixer",
        "libtinyalsa",
    ],
}

cc_binary {
    name: "agmcap",
    owner: "qti",

    vendor: true,

    cflags: [
        "-DBACKEND_CONF_FILE=\"/vendor/etc/backend_conf.xml\"",
        "-Wno-format-insufficient-args",
        "-Wno-unused-parameter",
        "-Wno-unused-result",
    ],
    srcs: ["agmcap.c"],

    header_libs: [
        "libagm_headers",
        "libarpal_headers",
    ],

    shared_libs: [
        "libagmmixer",
        "libtinyalsa",
    ],
}

cc_binary {
    name: "agmhostless",
    owner: "qti",

    vendor: true,

    cflags: [
        "-DBACKEND_CONF_FILE=\"/vendor/etc/backend_conf.xml\"",
        "-Wno-unused-parameter",
        "-Wno-unused-result",
    ],
    srcs: ["agmhostless.c"],

    header_libs: [
        "libagm_headers",
        "libarpal_headers",
    ],

    shared_libs: [
        "libagmmixer",
        "libtinyalsa",
    ],
