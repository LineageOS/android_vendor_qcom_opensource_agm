cc_library_shared {
    name: "libagm_pcm_plugin",
    owner: "qti",

    defaults: [
        "qtiaudio_dynamic_log_defaults",
    ],

    vendor: true,

    cflags: [
        "-Wall",
        "-Wno-enum-conversion",
        "-Wno-format",
        "-Wno-incompatible-pointer-types",
    ],
    srcs: ["src/agm_pcm_plugin.c"],

    header_libs: [
        "libagm_headers",
        "libarosal_headers",
    ],

    shared_libs: [
        "libagmclient",
        "libcutils",
        "liblog",
        "libsndcardparser",
        "libtinyalsa",
        "libutils",
    ],
}

cc_library_shared {
    name: "libagm_mixer_plugin",
    owner: "qti",

    defaults: [
        "qtiaudio_dynamic_log_defaults",
    ],

    vendor: true,
    srcs: ["src/agm_mixer_plugin.c"],

    header_libs: [
        "libagm_headers",
        "libarosal_headers",
    ],

    shared_libs: [
        "libagmclient",
        "libcutils",
        "liblog",
        "libsndcardparser",
        "libtinyalsa",
        "libutils",
    ],
    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
}

cc_library_shared {
    name: "libagm_compress_plugin",
    owner: "qti",

    defaults: [
        "qtiaudio_dynamic_log_defaults",
    ],

    vendor: true,

    include_dirs: [
        "external/tinycompress/include",
    ],
    srcs: ["src/agm_compress_plugin.c"],

    header_libs: [
        "libagm_headers",
        "libarosal_headers",
    ],

    shared_libs: [
        "libagmclient",
        "libcutils",
        "liblog",
        "libsndcardparser",
        "libtinyalsa",
        "libtinycompress",
        "libutils",
    ],
    cflags: [
        "-Wno-format",
        "-Wno-unused-function",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
}
